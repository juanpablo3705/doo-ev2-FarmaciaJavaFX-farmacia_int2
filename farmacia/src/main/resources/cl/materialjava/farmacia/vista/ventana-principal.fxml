<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox prefHeight="480.0" prefWidth="760.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.materialjava.farmacia.controlador.VentanaPrincipalController">
   <children>
      <Label text="Inventario de productos">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></Label>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label text="Buscar por nombre:" />
            <TextField fx:id="txtBuscar" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#buscar" text="Buscar" />
            <Button mnemonicParsing="false" onAction="#mostrarTodos" text="Mostrar todos" />
         </children>
      </HBox>
      <TableView fx:id="tablaProductos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="columnaTipo" text="Tipo">
               <cellValueFactory>
                  <PropertyValueFactory property="tipo"/>
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="columnaNombre" text="Nombre">
               <cellValueFactory>
                  <PropertyValueFactory property="nombre"/>
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="columnaStock" text="Stock">
               <cellValueFactory>
                  <PropertyValueFactory property="stock"/>
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="columnaPrecio" text="Precio">
               <cellValueFactory>
                  <PropertyValueFactory property="precio"/>
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="columnaDetalle" text="Detalle">
               <cellValueFactory>
                  <PropertyValueFactory property="detalle"/>
               </cellValueFactory>
            </TableColumn>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#abrirFormulario" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#eliminarSeleccionado" text="Eliminar" />
         </children>
      </HBox>
      <Label fx:id="lblMensaje" />
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="500.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.materialjava.farmacia.vista.FormularioProductoController">
   <children>
      <Label text="Nuevo producto">
         <font>
            <Font size="18.0" />
         </font></Label>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <Label text="Nombre" GridPane.rowIndex="1" />
            <Label text="Stock" GridPane.rowIndex="2" />
            <Label text="Precio ($)" GridPane.rowIndex="3" />
            <Label fx:id="lblDetalle" text="Principio activo:" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbTipo" onAction="#cambiarTipo" prefWidth="150.0" GridPane.columnIndex="1" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="txtDetalle" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <CheckBox fx:id="chkReceta" mnemonicParsing="false" text="Requiere receta" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
      </GridPane>
      <Label fx:id="lblError" />
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#confirmar" text="Confirmar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
